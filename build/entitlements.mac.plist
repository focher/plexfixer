<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      Nothing here loosens the hardened runtime, on purpose.

      This file used to carry four exemptions left over from Electron:
      allow-jit, allow-unsigned-executable-memory, disable-library-validation
      and allow-dyld-environment-variables. Electron ran a JavaScript engine
      inside the app's own process and needed them. This build does not: the
      page renders in WKWebView, whose JIT lives in a separate system process
      with entitlements of its own, and the binary links nothing but system
      libraries. The bundled ffmpeg is started as a process, not loaded as a
      library, and is not under the hardened runtime at all.

      What the last two cost is the reason to remove them rather than leave
      them: together they let any local process start PlexFixer with a
      DYLD_INSERT_LIBRARIES of its choosing and run its own code under this
      app's signature.
    -->
    <!-- Media lives wherever the user keeps it, including network shares. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
