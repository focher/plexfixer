{
  "name": "plexfixer",
  "version": "0.2.0",
  "description": "Analyze and fix MKV/M4V media files for reliable Plex direct play",
  "author": "Timothy Weaver",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cargo tauri dev",
    "build": "npm run typecheck && npm run renderer:build",
    "dist": "cargo tauri build && node scripts/dmg-add-unblock.mjs src-tauri/target/release/bundle/dmg/*.dmg",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "renderer:dev": "vite --config vite.tauri.config.ts",
    "renderer:build": "vite build --config vite.tauri.config.ts",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
